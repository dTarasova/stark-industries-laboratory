{
  "name": "stark-industries-laboratory",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/prototype", "/prototype/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "surkov-laboratory",
    // После создания D1 замените на database_id из Cloudflare.
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }]
}
